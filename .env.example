# Telegram Bot Notification
# สร้าง Bot Token ได้ที่ @BotFather บน Telegram
VITE_TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID ของกลุ่ม/ช่องที่ต้องการรับแจ้งเตือน (กลุ่มจะขึ้นต้นด้วย -)
VITE_TELEGRAM_CHAT_ID=-1000000000000

# คีย์สำหรับเรียก NAS API — ต้องตรงกับไฟล์ api-key.txt บน NAS
# หมายเหตุ: VITE_ จะถูกฝังลงไฟล์ JS ตอน build ผู้ใช้เปิดดูได้ ไม่ใช่ความลับจริง
VITE_NAS_API_KEY=NAS_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
